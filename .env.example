# Frontend (Vite — must be prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:8000
# Dev-only: opt into backend-assisted local CSV saving when an embedded browser blocks blob downloads.
# Leave false/unset in production.
VITE_ENABLE_LOCAL_FILE_SAVE=false

# Backend (goes in api/.env in production — this file is for documentation only)
ANTHROPIC_API_KEY=sk-ant-your-key-here
SUPABASE_SERVICE_KEY=your-service-role-key
RESEND_API_KEY=re_your-resend-key
RESEND_FROM_EMAIL=onboarding@resend.dev
APPROVAL_BASE_URL=http://localhost:8000
DATA_FEED_API_KEY=your-shared-secret-for-data-feed
# Dev-only: enables POST /api/local-files/save-csv for localhost requests.
# Never enable in production.
ENABLE_LOCAL_FILE_SAVE=false
LOCAL_FILE_SAVE_DIR=~/Downloads
ENVIRONMENT=development
